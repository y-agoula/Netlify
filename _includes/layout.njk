<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
   <style>
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
        max-width: 850px;
        margin: 0 auto;
        padding: 40px 20px;
        color: #444;
        background-color: #f9f9f9;
    }
    header {
        background: #fff;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        margin-bottom: 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    main {
        background: #fff;
        padding: 40px;
        border-radius: 10px;
        box-shadow: 0 2px 15px rgba(0,0,0,0.05);
    }
    footer {
        text-align: center;
        margin-top: 40px;
        font-size: 0.9em;
        color: #888;
    }
    a { color: #007bff; }
    a:hover { text-decoration: none; }
    </style>
</head>
<body>
    <header>
        <strong>Mijn Tech Blog</strong>
        <nav>
            <a href="/">Home</a>
        </nav>
    </header>

    <main>
        <h1>{{ title }}</h1>
        {{ content | safe }}
    </main>

    <footer>
        <p>&copy; 2026 - Youssef Agoula</p>
    </footer>
</body>
</html>