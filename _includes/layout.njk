<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
        body { font-family: sans-serif; line-height: 1.6; max-width: 800px; margin: 40px auto; padding: 0 20px; color: #333; }
        header { border-bottom: 2px solid #eee; margin-bottom: 20px; padding-bottom: 10px; }
        nav a { margin-right: 15px; text-decoration: none; color: #007bff; }
        h1 { color: #222; }
        footer { margin-top: 40px; font-size: 0.8em; color: #777; border-top: 1px solid #eee; padding-top: 20px; }
    </style>
</head>
<body>
    <header>
        <strong>Mijn Tech Blog</strong>
        <nav>
            <a href="/">Home</a>
        </nav>
    </header>

    <main>
        <h1>{{ title }}</h1>
        {{ content | safe }}
    </main>

    <footer>
        <p>&copy; 2026 - Youssef Agoula</p>
    </footer>
</body>
</html>